{
  "name": "pocketpet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "pocketpet": "dist/cli.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build:web": "vite build --config web/vite.config.ts",
    "build:bridge": "tsc -p tsconfig.json",
    "build": "npm run build:web && npm run build:bridge",
    "dev": "tsx src/cli.ts run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
