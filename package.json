{
  "name": "pocketpet",
  "version": "0.1.0",
  "description": "Desk clock + AI coding-agent pet for foldable phones",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HappyLiang12/pocketpet.git"
  },
  "homepage": "https://github.com/HappyLiang12/pocketpet#readme",
  "bugs": {
    "url": "https://github.com/HappyLiang12/pocketpet/issues"
  },
  "keywords": [
    "desktop-pet",
    "ai-agents",
    "foldable",
    "macos",
    "claude-code",
    "codex",
    "petdex"
  ],
  "bin": { "pocketpet": "dist/cli.js" },
  "engines": { "node": ">=20.6" },
  "scripts": {
    "build:web": "vite build --config web/vite.config.ts",
    "build:bridge": "tsc -p tsconfig.json",
    "build": "npm run build:web && npm run build:bridge",
    "dev": "tsx src/cli.ts run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
